{
    "name": "sayuprc/http-test-case",
    "description": "Library for HTTP testing",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "phpunit/phpunit": "^11.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8.0",
        "guzzlehttp/psr7": "^2.6.1",
        "phpstan/phpstan": "^2.0",
        "symplify/easy-coding-standard": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "HttpTestCase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "sayuprc",
            "email": "mkpoto15@gmail.com"
        }
    ],
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true
    },
    "scripts": {
        "phpunit": "phpunit",
        "phpstan": "phpstan analyze --memory-limit=2G --no-progress",
        "ecs": "vendor/bin/ecs check --ansi --no-progress-bar",
        "ecs-fix": "vendor/bin/ecs check --fix --ansi --no-progress-bar"
    }
}
